# Environment Variables Template
# Copy this file to .env and update values for your environment

# Server Configuration
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=docker
DB_PASSWORD=docker
DB_NAME=polls
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d

# API Documentation
API_TITLE=Webhook Inspector API
API_DESCRIPTION=API for capturing and inspecting webhook requests
API_VERSION=1.0.0

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Monitoring (Optional)
SENTRY_DSN=

# Environment-specific flags
DEBUG=false
